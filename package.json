{
  "name": "gamejam-vampire-survivors",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks",
    "dev": "pnpm --filter client dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/main",
    "test:build": "pnpm --filter client test:build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && node --test scripts/verify/*.test.mjs scripts/github/*.test.mjs && pnpm build && pnpm test:build",
    "server:up": "NODE_VERSION=$(cat .nvmrc) docker compose up -d --build server",
    "server:down": "docker compose down",
    "server:logs": "docker compose logs -f server",
    "server:sh": "docker compose exec server sh",
    "verify:launch": "node scripts/verify/launch.mjs",
    "verify:doctor": "node scripts/verify/doctor.mjs",
    "verify:e2e": "node scripts/verify/e2e.mjs",
    "verify:cleanup": "node scripts/verify/cleanup.mjs",
    "server:image": "docker build -f packages/server/Dockerfile --target runtime --build-arg NODE_VERSION=$(cat .nvmrc) -t vs-server:local .",
    "assets:sync": "tsx scripts/assets-sync.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
