# Production server settings (ADR 0017, deploy/server/README.md). Copy to .env next to compose.yaml; never commit .env.
# Host address and port the container is published on; keep 127.0.0.1 behind a reverse proxy on the same host
VS_BIND=127.0.0.1
VS_HOST_PORT=8787
# Origins allowed to open the WebSocket (ADR 0011): the GitHub Pages site. Must not be empty in production
ALLOWED_ORIGINS=https://ossca-thorvg.github.io
# 1 behind exactly one trusted reverse proxy that sets X-Forwarded-For (the TLS terminator); 0 when clients connect directly
TRUST_PROXY=1
# info or debug; anything else stops the server at startup
LOG_LEVEL=info
