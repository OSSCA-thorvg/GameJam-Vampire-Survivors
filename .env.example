# WebSocket URL of the game server, read by the client at build time (ADR 0006). Dev and e2e fall back to this local URL;
# production sets it from the repository variable VITE_SERVER_URL (a wss:// URL) in deploy.yml (ADR 0017); unset there, multiplayer is off
VITE_SERVER_URL=ws://localhost:8787/ws
# Port the server listens on inside the container; compose.yaml maps it to 8787 on the host (ADR 0006)
PORT=8787
# Server log level, info or debug; anything else stops the server at startup
LOG_LEVEL=info
# Comma-separated Origins allowed to open the WebSocket (ADR 0011): pnpm dev (5173) and verify-game (5180)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180
# 1 only behind one trusted reverse proxy: the client IP for rate limits is then the right-most X-Forwarded-For entry (ADR 0011)
TRUST_PROXY=0
# Test only (#60): versus time limit in seconds, 1-900, honoured only when NODE_ENV=test; blank keeps 900 s
MATCH_TIME_LIMIT_S_OVERRIDE=
